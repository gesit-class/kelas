<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Demo Form Bootstrap 5 Lengkap</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container my-5">
  <div class="card shadow">
    <div class="card-body">
      
      <h2 class="text-center mb-4">Demo Form Bootstrap 5</h2>


      <form class="needs-validation" novalidate>

        <!-- FORM CONTROL -->
        <h5 class="mt-4">1. Form Control</h5>
        <div class="mb-3">
          <label class="form-label">Nama Lengkap</label>
          <input type="text" class="form-control" placeholder="Masukkan nama lengkap" required>
          <div class="invalid-feedback">
            Nama wajib diisi.
          </div>
        </div>

        <!-- SELECT -->
        <h5 class="mt-4">2. Select</h5>
        <div class="mb-3">
          <label class="form-label">Pilih Kota</label>
          <select class="form-select" required>
            <option value="">-- Pilih Kota --</option>
            <option>Jakarta</option>
            <option>Bandung</option>
            <option>Surabaya</option>
          </select>
          <div class="invalid-feedback">
            Silakan pilih kota.
          </div>
        </div>

        <!-- CHECKS & RADIOS -->
        <h5 class="mt-4">3. Checks & Radios</h5>

        <label class="form-label">Hobi:</label>
        <div class="form-check">
          <input class="form-check-input" type="checkbox">
          <label class="form-check-label">Membaca</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox">
          <label class="form-check-label">Olahraga</label>
        </div>

        <label class="form-label mt-3">Jenis Kelamin:</label>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="gender" required>
          <label class="form-check-label">Laki-laki</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="gender">
          <label class="form-check-label">Perempuan</label>
          <div class="invalid-feedback">
            Pilih salah satu.
          </div>
        </div>

        <!-- RANGE -->
        <h5 class="mt-4">4. Range</h5>
        <label class="form-label">Level Kepuasan</label>
        <input type="range" class="form-range" min="0" max="100">

        <!-- INPUT GROUP -->
        <h5 class="mt-4">5. Input Group</h5>
        <div class="input-group mb-3">
          <span class="input-group-text">@</span>
          <input type="text" class="form-control" placeholder="Username">
        </div>

        <div class="input-group mb-3">
          <span class="input-group-text">Rp</span>
          <input type="number" class="form-control" placeholder="Jumlah">
          <span class="input-group-text">.00</span>
        </div>

        <!-- FLOATING LABELS -->
        <h5 class="mt-4">6. Floating Labels</h5>
        <div class="form-floating mb-3">
          <input type="email" class="form-control" placeholder="name@example.com" required>
          <label>Email address</label>
          <div class="invalid-feedback">
            Email wajib diisi.
          </div>
        </div>

        <!-- LAYOUT -->
        <h5 class="mt-4">7. Layout (Grid System)</h5>
        <div class="row">
          <div class="col-md-6 mb-3">
            <input type="text" class="form-control" placeholder="Nama Depan">
          </div>
          <div class="col-md-6 mb-3">
            <input type="text" class="form-control" placeholder="Nama Belakang">
          </div>
        </div>

        <!-- VALIDATION BUTTON -->
        <div class="mt-4">
          <button class="btn btn-primary w-100" type="submit">
            Submit Form
          </button>
        </div>

      </form>

    </div>
  </div>
</div>

<script>
// Bootstrap Validation Script
(() => {
  'use strict'
  const forms = document.querySelectorAll('.needs-validation')
  Array.from(forms).forEach(form => {
    form.addEventListener('submit', event => {
      if (!form.checkValidity()) {
        event.preventDefault()
        event.stopPropagation()
      }
      form.classList.add('was-validated')
    }, false)
  })
})();
</script>

</body>
</html>
